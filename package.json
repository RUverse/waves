{
  "name": "@ruverse/waves",
  "version": "0.1.0",
  "description": "Deterministic, configurable animated canvas waves for the web.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/alirezaekt/waves.git"
  },
  "keywords": [
    "canvas",
    "waves",
    "animation",
    "background",
    "generative-art"
  ],
  "sideEffects": false,
  "main": "./lib-dist/index.js",
  "module": "./lib-dist/index.js",
  "types": "./lib-dist/types/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-dist/types/package/index.d.ts",
      "import": "./lib-dist/index.js"
    }
  },
  "files": [
    "lib-dist",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:all": "bun run build && bun run build:lib",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.lib.json --noEmit",
    "test:package": "bun run build:lib && node --test tests/package.test.mjs",
    "prepack": "bun run build:lib"
  },
  "devDependencies": {
    "@internationalized/date": "^3.8.1",
    "@lucide/svelte": "^0.552.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tsconfig/svelte": "^5.0.5",
    "@types/node": "^24.6.0",
    "@types/p5": "^1.7.7",
    "bits-ui": "^2.11.0",
    "clsx": "^2.1.1",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.2",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "p5": "^2.0.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
